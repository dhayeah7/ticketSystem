# Copy to .env for local overrides. The defaults below already match
# docker-compose.yml, so the app and migrations work without a .env.

# Dev database
DATABASE_URL=postgres://ticket:ticket@localhost:5432/ticketsystem

# Database used by integration tests (created by the compose initdb script)
TEST_DATABASE_URL=postgres://ticket:ticket@localhost:5432/ticketsystem_test

# API port
PORT=3001
